server {
    listen 80;
    listen [::]:80;
    server_name today.cyberhome.junjun-garden.online;

    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name today.cyberhome.junjun-garden.online;

    ssl_certificate /etc/letsencrypt/live/today.cyberhome.junjun-garden.online/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/today.cyberhome.junjun-garden.online/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:TodayTodoSSL:10m;
    ssl_session_timeout 1d;

    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    auth_basic "Today Todo";
    auth_basic_user_file /etc/nginx/.htpasswd-today-todo;

    location / {
        proxy_pass http://127.0.0.1:3010;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }
}
